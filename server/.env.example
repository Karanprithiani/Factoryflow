# Copy to .env and fill in
PORT=4000
DATABASE_URL=postgres://factoryflow:factoryflow@localhost:5432/factoryflow
# Set PGSSL=true when using a hosted database (Neon, Supabase, Render)
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
# Used by the AI purchase-request parser (added later)
ANTHROPIC_API_KEY=
# Used only by `npm test` (a separate database so tests never touch your data)
TEST_DATABASE_URL=postgres://factoryflow:factoryflow@localhost:5432/factoryflow_test
